{
    "name": "selectwin/sdk",
    "description": "Official Selectwin PHP SDK — payments (card, PIX, boleto), subscriptions, webhooks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://selectwin.io/docs",
    "keywords": ["selectwin", "payments", "pix", "boleto", "subscriptions", "webhooks", "api", "sdk"],
    "authors": [{ "name": "Selectwin", "email": "help@selectwin.io" }],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.4",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Selectwin\\": ["src/", "lib/"] },
        "files": ["src/Exception/Exceptions.php"]
    },
    "autoload-dev": {
        "psr-4": { "Selectwin\\Test\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
